# Runtime
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://www.bytes.aurikrex.tech
APP_TIMEZONE=Africa/Lagos

# Database (choose the configured provider)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# ONESIGNAL_API_KEY is also accepted for existing deployments.

# Session and platform auth
JWT_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# Google reader sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Bytes <no-reply@aurikrex.tech>
SMTP_FROM_SUPPORT=Bytes Support <support@aurikrex.tech>

# Cloudinary post imagery
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Curation & Multimodal PDF Processing (Multi-key fallback enabled)
# Set your primary Gemini key:
GEMINI_API_KEY=
# Set your secondary fallback key (used automatically if primary hits quota or rate limits):
GEMINI_API_KEY_2=
# Optional aliases: GOOGLE_API_KEY, GOOGLE_API_KEY_2, or comma-separated keys in GEMINI_API_KEY


